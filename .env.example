# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection string. Local Docker Compose uses the value below.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app_db"

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV="development"
PORT="3001"
# Comma-separated list of allowed browser origins. Wildcards are rejected
# because the API uses credentialed cookies.
CORS_ORIGINS="http://localhost:3000"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-this-to-a-strong-random-secret-at-least-32-chars"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS="7"

# ---------------------------------------------------------------------------
# AI (optional)
# ---------------------------------------------------------------------------
# Without a key, every AI surface degrades to clearly labelled rule-based
# output. Extraction that needs a model returns an explicit error instead of
# inventing clinical data.
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_FAST_MODEL="llama-3.1-8b-instant"
GROQ_STRONG_MODEL="llama-3.3-70b-versatile"
GROQ_VISION_MODEL="meta-llama/llama-4-scout-17b-16e-instruct"
AI_TIMEOUT_MS="12000"

# ---------------------------------------------------------------------------
# Safety / demo
# ---------------------------------------------------------------------------
# DEMO_MODE makes document intake return clearly labelled sample data. It never
# reads the uploaded document. Leave off for real use.
DEMO_MODE="false"
# Used only by prisma/seed.ts. Never commit a production password.
DEMO_PASSWORD=""
EMERGENCY_NUMBER="112"

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Base URL of the API as seen by the browser. Include /api only if the API is
# mounted under a path prefix (the default app mounts routes at /api itself).
NEXT_PUBLIC_API_URL="http://localhost:3001"
